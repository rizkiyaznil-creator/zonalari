# Salin ke .env lalu ganti semua nilainya. JANGAN commit file .env.
#
#   cp .env.example .env
#   # ganti setiap nilai di bawah, lalu:
#   docker compose up -d

# --- Basis data ---------------------------------------------------------------
POSTGRES_USER=orthanc
POSTGRES_PASSWORD=ganti-password-ini

# --- Aplikasi RIS -------------------------------------------------------------
# Kunci penanda tangan cookie sesi. Buat dengan: openssl rand -hex 32
SESSION_SECRET=ganti-dengan-hasil-openssl-rand-hex-32

# Akun admin pertama, dibuat otomatis saat aplikasi pertama kali jalan.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-admin

HOSPITAL_NAME=RS Universitas Sumatera Utara

# Token yang dipakai layanan pemantau folder untuk menitipkan berkas ke RIS.
# Buat dengan: openssl rand -hex 32
INGEST_TOKEN=ganti-dengan-hasil-openssl-rand-hex-32

# --- Jaringan -----------------------------------------------------------------
# Port web yang diakses komputer-komputer RS.
HTTP_PORT=8080

# Port DICOM tempat alat radiologi mengirim citra (C-STORE).
# Standar DICOM adalah 104; 4242 dipakai agar tidak perlu hak akses root.
# Saat mengambil alih IP/AE tujuan lama, samakan port ini dengan port tujuan lama.
DICOM_PORT=4242
